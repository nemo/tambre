{
  "name": "@tambre/cli",
  "version": "0.1.0-spike",
  "description": "Hear what your coding agent is doing. A synth daemon driven by agent hooks.",
  "type": "module",
  "keywords": [
    "sound",
    "audio",
    "hooks",
    "sonification",
    "ai-agent",
    "claude-code",
    "codex"
  ],
  "author": "nemo",
  "license": "MIT",
  "homepage": "https://nemo.github.io/tambre/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemo/tambre.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/nemo/tambre/issues"
  },
  "bin": {
    "tambre": "dist/tambre.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/tambre.ts",
    "demo": "tsx src/tambre.ts demo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "node-web-audio-api": "^2.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
